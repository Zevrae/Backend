PORT=5000
MONGO_URI=mongodb://127.0.0.1:27017/zevrae
NODE_ENV=development
JWT_SECRET=change_this_to_a_long_random_secret
JWT_EXPIRES_IN=7d

# --- Google Sign-In ---
# From Google Cloud Console > APIs & Services > Credentials > OAuth 2.0 Client ID
# (Web application). Must be the SAME client ID the frontend uses
# (VITE_GOOGLE_CLIENT_ID) — the backend verifies tokens were issued for
# this exact audience. Leave blank to disable Google sign-in (POST
# /api/auth/google then returns 503 rather than crashing the app).
GOOGLE_CLIENT_ID=

# Public base URL of this API, used to build the email verification link
# (e.g. https://api.yourdomain.com). Defaults to http://localhost:<PORT>.
API_BASE_URL=http://localhost:5000

# How long an email verification token stays valid, in hours
EMAIL_VERIFICATION_EXPIRES_HOURS=24

# A product's demand counter (units ordered) crossing this number triggers a
# "possible delay due to high demand" email to the customer who just ordered
# it. Set to 0 to disable this notification entirely.
DEMAND_ALERT_THRESHOLD=50

# --- SMTP (for sending verification emails) ---
# If SMTP_HOST is left blank, emails are logged to the console instead of
# actually being sent — useful for local development without a mail server.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
EMAIL_FROM="Zevrae <no-reply@zevrae.com>"

# --- Payments (Razorpay) ---
# Get these from the Razorpay Dashboard > Settings > API Keys.
# Leave blank to run the app without payments enabled (orders are still
# created, just without a Razorpay checkout attached).
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_CURRENCY=INR
# From Dashboard > Settings > Webhooks, after you register /api/payments/webhook
RAZORPAY_WEBHOOK_SECRET=

# --- Product image storage (Appwrite Storage) ---
# Leave any of these blank to disable image uploads (existing image URLs still work).
APPWRITE_ENDPOINT=https://cloud.appwrite.io/v1
APPWRITE_PROJECT_ID=
APPWRITE_API_KEY=
APPWRITE_BUCKET_ID=
# Max time to wait on any single Appwrite Storage call before failing
# cleanly instead of hanging indefinitely. If every Appwrite-touching
# endpoint fails in production while everything else works fine, that's a
# strong signal this server can't reach APPWRITE_ENDPOINT at all (outbound
# firewall/egress rule, DNS, etc.) — this timeout won't fix that, but it
# turns an indefinite hang into a fast, clear, loggable error instead of a
# connection that eventually dies with no useful information (which is
# what shows up in the browser as a misleading CORS error)
APPWRITE_TIMEOUT_MS=20000

# --- Virtual try-on (external microservice) ---
# Base URL of the try-on microservice; POST /api/tryon calls
# `${TRYON_SERVICE_URL}/api/v1/tryon` with the uploaded images. Leave blank
# to disable the feature — POST /api/tryon then returns 503 rather than
# crashing the app.
TRYON_SERVICE_URL=
# How long to wait for the microservice before giving up. The microservice
# itself now caps Gemini calls at GEMINI_TIMEOUT_SECONDS (default 50s, see
# its own .env) — this value must be comfortably HIGHER than that (leaving
# room for the Appwrite upload + network overhead on top), or Node gives up
# first with an unhelpful ETIMEDOUT instead of letting the microservice's
# own clean timeout error come back. Since generation now runs as a
# background job (see tryonController.js), there's no user-facing cost to
# this being generous.
TRYON_SERVICE_TIMEOUT_MS=90000
# --- Password Reset ---
# How long a password reset link stays valid, in hours.
PASSWORD_RESET_EXPIRES_HOURS=1

